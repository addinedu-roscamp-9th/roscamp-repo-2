# admin_app/pages/live_render.py
from __future__ import annotations

import cv2
import numpy as np
from PyQt6.QtCore import Qt
from PyQt6.QtGui import QImage, QPixmap
from PyQt6.QtWidgets import QLabel, QSizePolicy


def _init_label_once(label: QLabel) -> None:
    if getattr(label, "_live_inited", False):
        return

    # 라벨이 pixmap을 강제로 늘리지 않게 (우리가 scaled로만 제어)
    label.setScaledContents(False)
    label.setAlignment(Qt.AlignmentFlag.AlignCenter)

    # 레이아웃이 pixmap sizeHint에 끌려가지 않게
    label.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
    label.setMinimumSize(1, 1)

    label._live_inited = True


def show_frame(
    label: QLabel | None,
    frame_bgr: np.ndarray | None,
    *,
    mode: str = "fit",  # "fit" | "fill" | "stretch"
) -> None:
    """
    mode
      - "fit": KeepAspectRatio (안 잘림, 공백 생길 수 있음)
      - "fill": KeepAspectRatioByExpanding (공백 없음, 잘릴 수 있음)
      - "stretch": IgnoreAspectRatio (공백 없음, 안 잘림, 대신 왜곡 가능)
    """
    if label is None or frame_bgr is None:
        return

    _init_label_once(label)

    lw = label.width()
    lh = label.height()
    if lw < 2 or lh < 2:
        return

    h, w = frame_bgr.shape[:2]
    rgb = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2RGB)
    qimg = QImage(rgb.data, w, h, w * 3, QImage.Format.Format_RGB888)
    pix = QPixmap.fromImage(qimg)

    if mode == "stretch":
        # 공백 X, 크롭 X, 대신 비율 왜곡 가능
        pix_out = pix.scaled(
            lw,
            lh,
            Qt.AspectRatioMode.IgnoreAspectRatio,
            Qt.TransformationMode.SmoothTransformation,
        )
    elif mode == "fill":
        # 공백 X, 대신 잘릴 수 있음(=확대된 느낌)
        pix_out = pix.scaled(
            lw,
            lh,
            Qt.AspectRatioMode.KeepAspectRatioByExpanding,
            Qt.TransformationMode.SmoothTransformation,
        )
    else:
        # 기본: 안 잘림, 공백 생길 수 있음
        pix_out = pix.scaled(
            lw,
            lh,
            Qt.AspectRatioMode.KeepAspectRatio,
            Qt.TransformationMode.SmoothTransformation,
        )

    label.setPixmap(pix_out)


def clear_label(label: QLabel | None) -> None:
    if label is None:
        return
    label.clear()
