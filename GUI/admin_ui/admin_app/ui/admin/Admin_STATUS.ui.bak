  <property name="styleSheet">
   <string notr="true">
        QWidget#Form { background-color: #0B0B0B; }
        QLabel { color: #FFFFFF; }

        QFrame#panel_header,
        QFrame#panel_footer,
        QFrame#card_car1,
        QFrame#card_car2,
        QFrame#card_arm,
        QFrame#panel_timeline,
        QFrame#panel_notes {
          background-color: #121212;
          border: 1px solid #222222;
          border-radius: 16px;
        }

        QLabel.section_title {
          color: #DDDDDD;
          font-size: 12pt;
          font-weight: bold;
        }

        QLabel.card_title {
          font-size: 16pt;
          font-weight: bold;
        }

        QLabel.kv_key {
          color: #AAAAAA;
          font-size: 10pt;
        }
        QLabel.kv_val {
          color: #FFFFFF;
          font-size: 10pt;
          font-weight: bold;
        }

        QLabel.ok { color: #6EEB83; font-weight: bold; }
        QLabel.warn { color: #FF4D4D; font-weight: bold; }
        QLabel.mid { color: #FFD166; font-weight: bold; }

        QProgressBar {
          border: 1px solid #2A2A2A;
          border-radius: 10px;
          text-align: center;
          background-color: #0F0F0F;
          color: #FFFFFF;
          font-size: 9pt;
        }
        QProgressBar::chunk {
          background-color: #3A86FF;
          border-radius: 10px;
        }

        QTableWidget {
          background-color: #101010;
          color: #FFFFFF;
          gridline-color: #2A2A2A;
          border: 1px solid #2A2A2A;
          border-radius: 12px;
        }
        QHeaderView::section {
          background-color: #151515;
          color: #DDDDDD;
          border: 1px solid #2A2A2A;
          padding: 6px;
          font-weight: bold;
        }

        QTextEdit {
          background-color: #101010;
          color: #FFFFFF;
          border: 1px solid #2A2A2A;
          border-radius: 12px;
          padding: 8px;
        }
      </string>
