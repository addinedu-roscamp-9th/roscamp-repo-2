          font-weight: bold;
          color: #DDDDDD;
        }

        QLabel.subtle {
          color: #888888;
          font-size: 10pt;
        }

        QLineEdit, QComboBox, QDateTimeEdit {
          background-color: #101010;
          color: #FFFFFF;
          border: 1px solid #2A2A2A;
          border-radius: 10px;
          padding: 8px 10px;
          font-size: 11pt;
        }

        QPushButton {
          background-color: #2D2D2D;
          color: #FFFFFF;
          border: 1px solid #444444;
          border-radius: 12px;
          padding: 10px 16px;
          font-size: 12pt;
          font-weight: bold;
        }
        QPushButton:hover { background-color: #3A3A3A; }
        QPushButton:pressed { background-color: #1F1F1F; }
        QPushButton:disabled { color: #888888; background-color: #1F1F1F; }

        QTableWidget {
          background-color: #101010;
          color: #FFFFFF;
          gridline-color: #2A2A2A;
          border: 1px solid #2A2A2A;
          border-radius: 12px;
        }
        QHeaderView::section {
          background-color: #151515;
          color: #DDDDDD;
          border: 1px solid #2A2A2A;
          padding: 6px;
          font-weight: bold;
